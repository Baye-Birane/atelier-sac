<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Projet info" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/Projet info" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="../Projet info" />
					<Add directory="backend/include" />
					<Add directory="data" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/Projet info" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Unit filename="backend/include/fichier.h" />
		<Unit filename="backend/include/stock.h" />
		<Unit filename="backend/src/fichier.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="backend/src/stock.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="data/stock.txt" />
		<Unit filename="data/transaction.txt" />
		<Unit filename="main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions />
	</Project>
</CodeBlocks_project_file>
